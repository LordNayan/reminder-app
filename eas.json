{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:4000/api"
      }
    },
    "development": {
      "developmentClient": true,
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": "version"
    }
  }
}
